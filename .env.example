# VideoMind AI — Environment Variables
# Copy this file to .env.local and fill in your values

# ──────────────────────────────────────
# GROQ API KEY (Required)
# Get yours free at: https://console.groq.com
# ──────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ──────────────────────────────────────
# GROQ MODEL (Optional — defaults to openai/gpt-oss-120b)
# Other options: llama-3.3-70b-versatile, llama-3.1-8b-instant
# See all models: https://console.groq.com/docs/models
# ──────────────────────────────────────
GROQ_MODEL=openai/gpt-oss-120b
