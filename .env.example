# Edurova — Environment Variables
# Copy this file to .env.local and fill in your values

# ──────────────────────────────────────
# GROQ API KEY (Required)
# Get yours free at: https://console.groq.com
# ──────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ──────────────────────────────────────
# GROQ MODEL (Optional — defaults to openai/gpt-oss-120b)
# Other options: llama-3.3-70b-versatile, llama-3.1-8b-instant
# See all models: https://console.groq.com/docs/models
# ──────────────────────────────────────
GROQ_MODEL=openai/gpt-oss-120b

# ──────────────────────────────────────
# FIREBASE AUTHENTICATION (Required for Google & Email Login)
# Get yours from Firebase Console: https://console.firebase.google.com
# Project Settings → General → Your apps (Web)
# Enable Authentication → Sign-in method: Google & Email/Password
# ──────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
